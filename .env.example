# Copy to .env locally. Never commit filled values.

# Project Memory (optional override of the owner Unix socket)
# CAFEROOMBA_PROJECT_MEMORY_URL=

# Offline Cosmos teacher. Leave empty for the mock backend.
# NVIDIA_API_KEY=
# COSMOS_TEACHER_URL=
# COSMOS_MODEL_ID=nvidia/cosmos3-nano-reasoner

# Google Cloud — do not use until Edwin approves project/region/budget.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=
# CAFEROOMBA_GCS_BUCKET=

# GitHub MCP (session or project). Prefer env reference, not a literal token in git.
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GH_TOKEN=
