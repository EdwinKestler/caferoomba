# Copy to .env locally. Never commit filled values.
# chmod 600 .env

# Project Memory (optional override of the owner Unix socket)
# CAFEROOMBA_PROJECT_MEMORY_URL=

# NVIDIA / Cosmos teacher (offline-at-deploy; live annotate only when authorized)
NVIDIA_API_KEY=
NGC_API_KEY=
COSMOS_TEACHER_URL=https://integrate.api.nvidia.com/v1
COSMOS_MODEL_ID=nvidia/cosmos3-nano-reasoner
# Local NIM (only if cosmos_nim_preflight.sh exits 0):
# COSMOS_TEACHER_URL=http://127.0.0.1:8000/v1

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ZONE=us-central1-c
CAFEROOMBA_GCS_BUCKET=gs://caferoomba

# xAI
X_AI_API_KEY=
XAI_API_KEY=

# Optional
# GITHUB_PERSONAL_ACCESS_TOKEN=
# OPENAI_API_KEY=
