# Local environment
.venv/
.venv-dev/
.env
__pycache__/
*.py[cod]
*.py.save
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/
coverage.xml
*.log
notebooks/.ipynb_checkpoints/

# Project Memory v2.5 local state (Redis dump, SQLite ledger, packs, keys)
.caferoomba/
*.pmem
*.key

# Videos — local recordings are hundreds of MB to >1 GB
/docs/videos/
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v
*.mpeg
*.mpg
*.3gp
*.3g2

# Pictures — camera photos are >2 MB; video frames add ~30 MB together.
# Small UI icons in static/ stay tracked.
/docs/pictures/

# Large office / slicer binaries
*.pptx
*.ppt
*.gcode

# Generated learning artifacts (keep fixtures tracked)
artifacts/
data/generated/
data/cache/
# Owner raw FPV/external media and labels (private). Track READMEs only.
data/raw/**
!data/raw/**/
!data/raw/**/README.md
*.onnx
*.pt
*.pth
*.engine

# Allow tiny synthetic clips used by offline tests
!fixtures/synthetic/
!fixtures/synthetic/**

# Disposable static website output (source is site/ and allowlisted Markdown)
/_site/

# Explicit owner-approved public web previews; raw originals remain ignored.
!/site/assets/fpv-sample.mp4
!/site/assets/external-sample.mp4
