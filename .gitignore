/docs/videos/
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v
*.mpeg
*.mpg
*.3gp
*.3g2

# Pictures — camera photos are >2 MB; video frames add ~30 MB together.
# Small UI icons in static/ stay tracked.
/docs/pictures/

# Large office / slicer binaries
*.pptx
*.ppt
*.gcode
