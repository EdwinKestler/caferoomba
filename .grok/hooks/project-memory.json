{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/project_memory_agent.sh ensure",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/project_memory_agent.sh stop-gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
